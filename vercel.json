{
  "version": 2,
  "installCommand": "npm install --prefix backend",
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/renewal-reminders",
      "schedule": "0 10 * * *"
    }
  ]
}
